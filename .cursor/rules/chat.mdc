#### 2. 数据结构设计

```typescript
// 一级命令定义
interface Command {
  id: string;
  name: string;
  description: string;
  icon: string;
  hasSubCommands: boolean;      // 是否有子命令
  subCommandsEndpoint?: string; // 子命令获取接口
  subCommandsParams?: string[]; // 子命令所需参数
  directExecute?: boolean;      // 是否直接执行
  template?: string;           // 提示词模板
}

// 子命令定义
interface SubCommand {
  id: string;
  name: string;
  description: string;
  icon: string;
  template: string;           // 提示词模板
  params?: ParamDefinition[]; // 参数定义
}

// 参数定义
interface ParamDefinition {
  name: string;
  description: string;
  required: boolean;
  defaultValue?: string;
}
```

#### 3. 交互流程实现

1. **子命令获取流程**：
```typescript
async function fetchSubCommands(command: Command, context: any): Promise<SubCommand[]> {
  if (!command.hasSubCommands) return [];
  
  // 构建请求参数
  const params: Record<string, any> = {};
  if (command.subCommandsParams) {
    command.subCommandsParams.forEach(param => {
      params[param] = context[param] || null;
    });
  }
  
  // 调用API获取子命令
  try {
    const response = await fetch(command.subCommandsEndpoint!, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(params)
    });
    
    return await response.json();
  } catch (error) {
    console.error('获取子命令失败:', error);
    return [];
  }
}
```

2. **子命令展示**：
```typescript
function displaySubCommands(subCommands: SubCommand[]): void {
  // 创建AI回复气泡，展示子命令选项
  const message = {
    role: 'assistant',
    content: '请选择以下操作：',
    subCommands: subCommands
  };
  
  messages.value.push(message);
  
  // 滚动到底部
  nextTick(() => {
    scrollToBottom();
  });
}
```

3. **子命令选择处理**：
```typescript
function handleSubCommandSelect(subCommand: SubCommand): void {
  // 创建用户选择消息
  const userMessage = {
    role: 'user',
    content: `已选择: ${subCommand.name}`
  };
  
  messages.value.push(userMessage);
  
  // 处理子命令模板
  const processedTemplate = processTemplate(subCommand.template, currentContext);
  
  // 发送到AI处理
  sendToAI(processedTemplate);
}
```

#### 4. 模板处理机制

```typescript
function processTemplate(template: string, context: any): string {
  // 替换上下文变量
  let result = template;
  
  // 替换{input}为用户输入
  if (context.input) {
    result = result.replace(/{input}/g, context.input);
  }
  
  // 替换其他上下文变量
  Object.entries(context).forEach(([key, value]) => {
    result = result.replace(new RegExp(`{${key}}`, 'g'), String(value));
  });
  
  return result;
}
```

